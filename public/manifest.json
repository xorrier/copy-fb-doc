{
  "manifest_version": 3,
  "name": "Firestore Copy JSON",
  "version": "2.0.0",
  "description": "Copy any Firestore document as formatted JSON with one click. Supports nested maps, arrays, and all field types.",
  "homepage_url": "https://github.com/xorrier/firestore-copy-json",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["clipboardWrite"],
  "content_scripts": [
    {
      "matches": ["https://console.firebase.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
